<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- マイクを使う理由。初めて「開始」を押したときの許可の画面に出る -->
	<key>NSMicrophoneUsageDescription</key>
	<string>直近の会話をあとからさかのぼって残せるように、マイクで録音し続けます。音声はこの iPhone の外に出ません。</string>
	<!-- Background Modes の「Audio, AirPlay, and Picture in Picture」。画面を消しても録音を続けるために必要 -->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
	<!-- 「ファイル」アプリの「この iPhone 内 > あとろく」に Documents フォルダを見せる。段階0で録った音を聞き比べるため -->
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
</dict>
</plist>
